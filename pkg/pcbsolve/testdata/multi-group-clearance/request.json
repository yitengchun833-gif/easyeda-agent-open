      {
        "id": "dependent", "anchorRef": "M2", "refs": ["M2", "C2"],
        "fixedAxes": ["y", "rotation"],
        "translationSearch": {"step": 10, "maxDistance": 60}
      }
    ]
  },
  "routing": {
    "step": 10, "maxDetour": 0, "maxStates": 100000,
    "demands": [
      {"id": "a", "net": "A", "from": "U1.1", "to": "J1.1", "width": 4, "layers": [1], "maxVias": 0},
      {"id": "b", "net": "B", "from": "U1.2", "to": "J1.2", "width": 4, "layers": [1], "maxVias": 0},
      {"id": "external", "net": "EXT", "from": "U1.3", "to": "M1.3", "width": 4, "layers": [2], "maxVias": 0}
    ]
  }
